+
+/// LAB EXPERIMENT ONLY (scratch copy): per-commit trace for the D4 spike,
+/// group commit variants and memory. `LPG_LAB_FS`, `LPG_COMMIT_THREADS`,
+/// `LPG_COMMIT_PAGES`, `LPG_PERF_N` as `commit_fixed`; `LPG_X_TRACE` names
+/// the output file (lines `c <end unix ns> <latency ns>` and
+/// `s <start unix ns> <end unix ns>`).
+#[test]
+#[ignore = "laboratory experiment"]
+fn commit_trace() {
+    let fs: String = env_or("LPG_LAB_FS", "ext4".to_owned());
+    let base = match fs.as_str() {
+        "ext4" => env_dir("LPG_LAB_EXT4"),
+        "xfs" => env_dir("LPG_LAB_XFS"),
+        other => panic!("unknown LPG_LAB_FS {other}"),
+    };
+    let threads: u64 = env_or("LPG_COMMIT_THREADS", 16);
+    let pages: u64 = env_or("LPG_COMMIT_PAGES", 1);
+    let n: u64 = env_or("LPG_PERF_N", 1_000);
+    let db = build(&base, KEYS, CAP, no_trigger());
+    crate::storage::x::SEGMENTS.lock().unwrap().clear();
+    let before = db.sink.snapshot();
+    let p0 = Probe::now();
+    let t = Instant::now();
+    let traces: Vec<Vec<(u128, u128)>> = std::thread::scope(|s| {
+        let hs: Vec<_> = (0..threads)
+            .map(|th| {
+                let (e, tree) = (&db.engine, db.tree);
+                s.spawn(move || {
+                    let mut rng = StdRng::seed_from_u64(th);
+                    let mut v = Vec::with_capacity(n as usize);
+                    for i in 0..n {
+                        let a = Instant::now();
+                        commit_pages(e, tree, KEYS, pages, (th + i) as u8, &mut rng);
+                        let lat = a.elapsed().as_nanos();
+                        v.push((crate::storage::x::unix_ns(), lat));
+                    }
+                    v
+                })
+            })
+            .collect();
+        hs.into_iter().map(|h| h.join().unwrap()).collect()
+    });
+    let seconds = t.elapsed().as_secs_f64();
+    let p1 = Probe::now();
+    let m = db.sink.snapshot().since(&before);
+    let mut lats: Vec<u64> = traces.iter().flatten().map(|&(_, l)| l as u64).collect();
+    let commits = lats.len() as u64;
+    lats.sort_unstable();
+    let segs = crate::storage::x::SEGMENTS.lock().unwrap().clone();
+    let mut out = String::new();
+    for v in &traces {
+        for &(e, l) in v {
+            writeln!(out, "c {e} {l}").unwrap();
+        }
+    }
+    for &(a, b) in &segs {
+        writeln!(out, "s {a} {b}").unwrap();
+    }
+    if let Ok(p) = std::env::var("LPG_X_TRACE") {
+        write_text(Path::new(&p), &out);
+    }
+    println!(
+        "LAB fs={fs} threads={threads} pages={pages} n={n} seconds={seconds:.3} commits={commits} \
+         commits_per_s={:.0} p50_us={:.1} p99_us={:.1} max_us={:.1} groups={} segments={} \
+         accountant_used={} accountant_peak={} accounted_gauge={:?} rss_kib={} hwm_kib={} rss_start_kib={} write_bytes={}",
+        commits as f64 / seconds,
+        percentile(&lats, 0.5) as f64 / 1e3,
+        percentile(&lats, 0.99) as f64 / 1e3,
+        *lats.last().unwrap() as f64 / 1e3,
+        m.counter(GROUPS),
+        segs.len(),
+        db.engine.accountant().used(),
+        db.engine.accountant().peak(),
+        db.sink.snapshot().gauge(crate::obs::names::cache::ACCOUNTED_BYTES),
+        p1.rss_kib,
+        p1.hwm_kib,
+        p0.rss_kib,
+        p1.write_bytes - p0.write_bytes,
+    );
+    drop(db.engine);
+    drop(db.dir);
+}
