+++ lpgx/src/storage/mod.rs	2026-10-03 09:47:12.804536080 +0100
@@ -225,3 +225,33 @@
 
 /// A lock taken by [`Storage::try_lock`]; dropping it releases the lock.
 pub trait StorageLock: Send + Sync {}
+
+/// LAB EXPERIMENT ONLY (scratch copy, not the repository): switches read
+/// once from the environment.
+pub(crate) mod x {
+    use std::sync::OnceLock;
+    use std::sync::Mutex;
+    fn flag(cell: &'static OnceLock<u64>, var: &str) -> u64 {
+        *cell.get_or_init(|| std::env::var(var).ok().and_then(|v| v.parse().ok()).unwrap_or(0))
+    }
+    /// Skip the step-6 page copies (no undo possible; failure-free runs only).
+    pub(crate) fn nocopy() -> bool {
+        static C: OnceLock<u64> = OnceLock::new();
+        flag(&C, "LPG_X_NOCOPY") != 0
+    }
+    /// Writer sleeps this many µs before closing a group (PostgreSQL commit_delay).
+    pub(crate) fn delay_us() -> u64 {
+        static C: OnceLock<u64> = OnceLock::new();
+        flag(&C, "LPG_X_DELAY_US")
+    }
+    /// Committers wait on per-group condvar slots (InnoDB flush_events).
+    pub(crate) fn slots() -> bool {
+        static C: OnceLock<u64> = OnceLock::new();
+        flag(&C, "LPG_X_SLOTS") != 0
+    }
+    /// Segment creations: (start, end) in Unix ns.
+    pub(crate) static SEGMENTS: Mutex<Vec<(u128, u128)>> = Mutex::new(Vec::new());
+    pub(crate) fn unix_ns() -> u128 {
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+    }
+}
